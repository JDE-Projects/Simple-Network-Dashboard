#!/usr/bin/env bash
# Simple Network Dashboard managed password reset command v1
set -euo pipefail

APP_DIR="/opt/simple-network-dashboard"
AUTH_FILE="/var/lib/simple-network-dashboard/auth.json"
SERVICE_NAME="simple-network-dashboard"

if [ "${EUID}" -ne 0 ]; then
    echo "Run with sudo: sudo snd-reset-password" >&2
    exit 1
fi

exec "${APP_DIR}/venv/bin/python" "${APP_DIR}/auth.py" reset \
    --auth-file "${AUTH_FILE}" --service-name "${SERVICE_NAME}"
